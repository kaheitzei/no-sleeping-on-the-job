#!/bin/bash
# no-sleeping-on-the-job — installer
#
# Keeps the Mac awake while Claude Code is working, by wiring two hook
# scripts into ~/.claude/settings.json (UserPromptSubmit/PreToolUse to
# acquire a `caffeinate` lock, Stop/SessionEnd to release it once the
# Claude desktop app's own "keep awake" assertion goes away).
#
# This file is self-contained (the hook scripts are embedded below as
# base64) — download it and run it, nothing else to fetch.
#
#   curl -fsSL <raw-url>/install.sh -o install.sh && bash install.sh
#   bash install.sh --uninstall
#
# Generated by build.sh from hooks/prevent-sleep.sh and hooks/allow-sleep.sh.
# Do not edit by hand — edit those sources and re-run build.sh instead.

set -euo pipefail

log() { printf '%s\n' "$*"; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

if [ "$(uname -s)" != "Darwin" ]; then
  die "no-sleeping-on-the-job only works on macOS (it relies on caffeinate and pmset). Detected: $(uname -s)."
fi

command -v python3 >/dev/null 2>&1 \
  || die "python3 is required to safely edit ~/.claude/settings.json. Install Xcode command line tools (xcode-select --install) and re-run."

HOOKS_DIR="$HOME/.claude/hooks"
SETTINGS="$HOME/.claude/settings.json"
PREVENT_PATH="$HOOKS_DIR/prevent-sleep.sh"
ALLOW_PATH="$HOOKS_DIR/allow-sleep.sh"

PREVENT_SLEEP_B64="__PREVENT_SLEEP_B64__"
ALLOW_SLEEP_B64="__ALLOW_SLEEP_B64__"

install_scripts() {
  mkdir -p "$HOOKS_DIR"
  printf '%s' "$PREVENT_SLEEP_B64" | base64 --decode >"$PREVENT_PATH"
  printf '%s' "$ALLOW_SLEEP_B64" | base64 --decode >"$ALLOW_PATH"
  chmod +x "$PREVENT_PATH" "$ALLOW_PATH"
  log "Installed hook scripts to $HOOKS_DIR"
}

remove_scripts() {
  rm -f "$PREVENT_PATH" "$ALLOW_PATH"
  log "Removed hook scripts from $HOOKS_DIR"
}

merge_settings() {
  python3 - "$SETTINGS" "$PREVENT_PATH" "$ALLOW_PATH" <<'PYEOF'
import json, os, shutil, sys, time

settings_path, prevent_path, allow_path = sys.argv[1:4]

events = {
    "UserPromptSubmit": prevent_path,
    "PreToolUse": prevent_path,
    "Stop": allow_path,
    "SessionEnd": allow_path,
}

if os.path.exists(settings_path):
    with open(settings_path, "r", encoding="utf-8") as f:
        raw = f.read().strip()
    data = json.loads(raw) if raw else {}
    backup = f"{settings_path}.bak-{int(time.time())}"
    shutil.copy2(settings_path, backup)
    print(f"Backed up existing settings to {backup}")
else:
    os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    data = {}

hooks = data.setdefault("hooks", {})

added = False
for event, command in events.items():
    entries = hooks.setdefault(event, [])
    already = any(
        h.get("command") == command
        for entry in entries
        for h in entry.get("hooks", [])
    )
    if already:
        continue
    entries.append({"hooks": [{"type": "command", "command": command, "timeout": 5}]})
    added = True

with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\n")

print("Hooks wired up in settings.json" if added else "Hooks already present in settings.json, nothing to add")
PYEOF
}

unmerge_settings() {
  if [ ! -f "$SETTINGS" ]; then
    log "No settings.json found, nothing to clean up."
    return
  fi
  python3 - "$SETTINGS" "$PREVENT_PATH" "$ALLOW_PATH" <<'PYEOF'
import json, shutil, sys, time

settings_path, prevent_path, allow_path = sys.argv[1:4]
commands = {prevent_path, allow_path}

with open(settings_path, "r", encoding="utf-8") as f:
    raw = f.read().strip()
data = json.loads(raw) if raw else {}

hooks = data.get("hooks")
if not hooks:
    print("No hooks block found, nothing to clean up.")
    sys.exit(0)

backup = f"{settings_path}.bak-{int(time.time())}"
shutil.copy2(settings_path, backup)
print(f"Backed up existing settings to {backup}")

changed = False
for event in list(hooks.keys()):
    new_entries = []
    for entry in hooks[event]:
        original = entry.get("hooks", [])
        filtered = [h for h in original if h.get("command") not in commands]
        if filtered != original:
            changed = True
        if filtered:
            entry["hooks"] = filtered
            new_entries.append(entry)
        elif not original:
            new_entries.append(entry)
        # else: every hook in this entry was ours -> drop the whole entry
    hooks[event] = new_entries
    if not hooks[event]:
        del hooks[event]

if not hooks:
    data.pop("hooks", None)

with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\n")

print("Removed no-sleeping-on-the-job hooks from settings.json" if changed else "No matching hooks found to remove.")
PYEOF
}

ACTION="${1:-install}"

case "$ACTION" in
  install)
    install_scripts
    merge_settings
    log ""
    log "Done. Start a new Claude Code session to pick up the hooks."
    log "Verify while Claude is working:  pmset -g assertions | grep caffeinate"
    log "Debug log:  touch ~/.claude/hooks/.sleep-debug   (writes to /tmp/claude_caffeinate/hooks.log)"
    log "Uninstall:  bash $0 --uninstall"
    ;;
  --uninstall|uninstall)
    unmerge_settings
    remove_scripts
    log "Uninstalled."
    ;;
  *)
    die "Unknown argument: $ACTION (run with no arguments to install, or --uninstall to remove)"
    ;;
esac
